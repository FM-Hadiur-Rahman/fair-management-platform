{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    { "source": "/old-path", "destination": "/new-path", "permanent": true }
  ],
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.js" }],
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
